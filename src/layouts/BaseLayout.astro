---
import "../styles/global.css";

const {
  title = "饥荒联机版食谱大全",
  description = "《饥荒联机版》81 道烹饪锅料理速查。",
} = Astro.props;

const base = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname;
const links = [
  {
    href: base,
    label: "料理食谱",
    active: currentPath === base,
  },
  {
    href: `${base}farming/`,
    label: "巨大化配比",
    active: currentPath.includes("/farming"),
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#171914" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/png"
      href={`${base}images/characters/wilson.png`}
      sizes="256x256"
    />
    <link
      rel="apple-touch-icon"
      href={`${base}images/characters/wilson.png`}
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-nav">
      <nav class="site-nav-inner" aria-label="主导航">
        <div class="site-links">
          {
            links.map((link) => (
              <a
                href={link.href}
                class:list={{ active: link.active }}
                aria-current={link.active ? "page" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>
    <slot />
  </body>
</html>
