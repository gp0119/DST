  "rules": [
    {
      "title": "必须当季",
      "text": "所有作物都要处于喜爱季节，否则每个生长阶段都会积累季节压力。"
    },
    {
      "title": "同种至少 4 株",
      "text": "每株作物周围 1 格范围内，同种作物含自身至少 4 株。双田方案需要相邻摆放。"
    },
    {
      "title": "养分先有底量",
      "text": "页面方案让三类养分收支归零；首次开田仍建议先补足基础养分。"
    },
    {
      "title": "保持湿润",
      "text": "每个生长阶段都要确保地面湿润；无雨时通常每阶段浇一次即可。"
    },
    {
      "title": "每阶段照料",
      "text": "每个阶段交谈一次，或使用乐器、友好果蝇等范围照料手段。"
    },
    {
      "title": "无杂草、不拥挤",
      "text": "清除杂草与腐烂物；同一农田地块最多 10 株作物或杂草。"
    }
  ],
