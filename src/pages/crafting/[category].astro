---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CraftingExplorer from "../../components/CraftingExplorer.vue";
import {
  craftingCategories,
  getCategoryItems,
  makeScopedCraftingData,
} from "../../lib/crafting.js";

export function getStaticPaths() {
  return craftingCategories
    .filter((category) => category.id !== "character")
    .map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL;
const items = getCategoryItems(category.id);
const pageData = makeScopedCraftingData(items);
const description = `《饥荒联机版》${category.name}分类共 ${items.length} 项制作配方、材料与解锁条件。`;
---

<BaseLayout title={`${category.name}制作配方 · 饥荒联机版`} description={description}>
  <main id="main" class="container crafting-main">
    <nav class="crafting-breadcrumb" aria-label="面包屑">
      <a href={`${base}crafting/`}>全部制作</a>
      <span aria-hidden="true">/</span>
      <strong>{category.name}</strong>
    </nav>

    <CraftingExplorer client:load data={pageData} />
  </main>
</BaseLayout>
