---
import BaseLayout from "../layouts/BaseLayout.astro";
import FarmingExplorer from "../components/FarmingExplorer.vue";
import farming from "../data/farming.json";
import farmingExamples from "../data/farming-examples.json";

const description =
  "《饥荒联机版》巨大作物四季配比速查：春夏秋冬 79 组当季配比、自循环养分比例、双田种植格与巨大化必要条件。";
---

<BaseLayout title="巨大作物四季配比 · 饥荒联机版种地速查" description={description}>
  <main id="main" class="container farming-main">
    <FarmingExplorer
      client:load
      seasons={farming.seasons}
      crops={farming.crops}
      examples={farmingExamples.examples}
    />
  </main>
</BaseLayout>
