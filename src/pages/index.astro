---
import BaseLayout from "../layouts/BaseLayout.astro";
import crafting from "../data/crafting.json";
import quests from "../data/quests.json";

const base = import.meta.env.BASE_URL;
const tools = [
  {
    path: "recipes", title: "料理食谱", stat: "81 道料理",
    description: "查询配方与料理效果", image: "images/food/Dragonpie.webp",
  },
  {
    path: "crafting", title: "全部制作", stat: `${crafting.meta.itemCount} 项制作`,
    description: "查找物品与制作材料", image: "images/crafting/torch.png",
  },
  {
    path: "farming", title: "巨大化配比", stat: "79 组配比",
    description: "季节配比与种植布局", image: "images/ingredients/pumpkin.png",
  },
  {
    path: "skills", title: "角色技能树", stat: "12 位角色",
    description: "洞察分配与解锁条件", image: "images/characters/wormwood.png",
  },
  {
    path: "quests", title: "任务路线", stat: `${quests.quests.length} 条路线`,
    description: "前置物品与任务流程", image: "images/ingredients/nightmarefuel.png",
  },
  {
    path: "sequitor", title: "追随者谜题", stat: "3 种谜题",
    description: "挑战谜题，逐步解法", image: "static/quests/Glove.png",
  },
];
---

<BaseLayout
  title="饥荒联机版手册"
  description="汇集料理食谱、全部制作、巨大作物配比、角色技能树、任务路线与追随者谜题的《饥荒联机版》中文速查工具。"
>
  <main id="main" class="home-main">
    <section class="home-tools" aria-labelledby="tools-title">
      <header class="home-section-heading">
        <p class="home-kicker">DST MANUAL</p>
        <h1 id="tools-title">饥荒联机版手册</h1>
      </header>
      <div class="home-tool-grid">
        {
          tools.map((tool) => (
            <a class={`home-tool-card ${tool.path}`} href={`${base}${tool.path}/`}>
              <div class="home-card-topline">
                <img src={`${base}${tool.image}`} alt="" width="56" height="56" />
                <span>{tool.stat}</span>
              </div>
              <div class="home-card-copy">
                <h2>{tool.title}</h2>
                <p>{tool.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
    <footer class="home-footer">
      <span>KEEP THE FIRE BURNING</span>
      <span>饥荒联机版 · 中文速查</span>
    </footer>
  </main>
</BaseLayout>
