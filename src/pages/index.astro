---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
const tools = [
  {
    href: `${base}recipes/`,
    eyebrow: "Cookbook",
    title: "料理食谱",
    description:
      "按名称、食材与属性筛选 81 道烹饪锅料理，查看常用配方、角色偏好和特殊效果。",
    stat: "81 道料理",
    className: "recipes",
    images: [
      `${base}images/Meaty Stew.webp`,
      `${base}images/Dragonpie.webp`,
      `${base}images/Pierogi.webp`,
    ],
  },
  {
    href: `${base}farming/`,
    eyebrow: "Farming",
    title: "巨大化配比",
    description:
      "按季节查找自循环养分配比，并用单田、双田与四田布局快速安排作物位置。",
    stat: "79 组配比",
    className: "farming",
    images: [
      `${base}images/ingredients/dragonfruit.png`,
      `${base}images/ingredients/pumpkin.png`,
      `${base}images/ingredients/potato.png`,
    ],
  },
  {
    href: `${base}skills/`,
    eyebrow: "Insight",
    title: "角色技能树",
    description:
      "为 12 位角色分配洞察点，直观看清前置、互斥分支、阵营与首领解锁条件。",
    stat: "12 位角色",
    className: "skills",
    images: [
      `${base}images/characters/wilson.png`,
      `${base}images/characters/wormwood.png`,
      `${base}images/characters/wanda.png`,
    ],
  },
  {
    href: `${base}quests/`,
    eyebrow: "Questlines",
    title: "任务路线",
    description:
      "查看奶奶岛、远古织影者、天体英雄与裂隙终局的前置物品、流程和可保存进度。",
    stat: "5 条路线",
    className: "quests",
    images: [
      `${base}images/characters/maxwell.png`,
      `${base}images/ingredients/nightmarefuel.png`,
      `${base}images/characters/wanda.png`,
    ],
  },
];
---

<BaseLayout
  title="饥荒联机版生存工具箱"
  description="汇集料理食谱、巨大作物配比与角色技能树的《饥荒联机版》中文速查工具。"
>
  <main id="main" class="home-main">
    <section class="home-tools" aria-labelledby="tools-title">

      <div class="home-tool-grid">
        {
          tools.map((tool, index) => (
            <a class={`home-tool-card ${tool.className}`} href={tool.href}>
              <div class="home-card-topline">
                <span>{tool.eyebrow}</span>
                <small>0{index + 1}</small>
              </div>
              <div class="home-card-images" aria-hidden="true">
                {tool.images.map((image) => <img src={image} alt="" loading="lazy" />)}
              </div>
              <div class="home-card-copy">
                <span>{tool.stat}</span>
                <h3>{tool.title}</h3>
                <p>{tool.description}</p>
              </div>
              <span class="home-card-action">
                打开工具
                <b aria-hidden="true">→</b>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="home-footer">
      <span>KEEP THE FIRE BURNING</span>
      <span>饥荒联机版 · 中文速查</span>
    </footer>
  </main>
</BaseLayout>
