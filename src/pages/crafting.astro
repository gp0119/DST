---
import BaseLayout from "../layouts/BaseLayout.astro";
import { crafting, craftingCategories } from "../lib/crafting.js";

const base = import.meta.env.BASE_URL;
const characterCategory = craftingCategories.find((category) => category.id === "character");
const description = `《饥荒联机版》${crafting.meta.itemCount} 项制作配方中文速查：先选分类，再查看制作材料与解锁条件。`;
---

<BaseLayout title="饥荒联机版全部制作配方" description={description}>
  <main id="main" class="container crafting-main">
    <header class="crafting-hero">
      <div>
        <p>CRAFTING COMPENDIUM</p>
        <h1>全部制作</h1>
        <span>
          先选择制作分类，再查看该分类下的物品、材料与解锁条件；冒险家物品还可继续按人物选择。
        </span>
      </div>
      <aside aria-label="数据摘要">
        <strong>{craftingCategories.length}</strong>
        <span>个制作分类</span>
        <small>{crafting.meta.itemCount} 项配方 · Patch {crafting.meta.chineseDataPatch}</small>
      </aside>
    </header>

    <section class="crafting-directory" aria-labelledby="crafting-categories-title">
      <header>
        <p>STEP 1</p>
        <h2 id="crafting-categories-title">选择分类</h2>
        <span>每件物品会出现在游戏对应的制作分类中。</span>
      </header>
      <div class="crafting-directory-grid">
        {
          craftingCategories.map((category) => (
            <a
              class:list={{
                "crafting-directory-card": true,
                featured: category.id === characterCategory?.id,
              }}
              href={`${base}crafting/${category.id}/`}
            >
              <div class="crafting-directory-image">
                <img src={`${base}${category.image}`} alt={`${category.name}分类`} loading="lazy" />
              </div>
              <div>
                <span>{category.id === "character" ? "下一步选择人物" : "制作分类"}</span>
                <h2>{category.name}</h2>
                <p>{category.count} 项制作</p>
              </div>
              <b aria-hidden="true">→</b>
            </a>
          ))
        }
      </div>
    </section>

    <footer class="crafting-source-note">
      <p>
        配方清单、中文名称与制作描述按 Patch {crafting.meta.chineseDataPatch} 的游戏数据整理。
        分类和本地图标参考 Steam Build {crafting.meta.steamBuildId}（{crafting.meta.gameDataUpdatedAt}）的资源快照。
      </p>
      <p>
        结构化数据参考
        <a href={crafting.meta.sourceRepository} target="_blank" rel="noreferrer">dst-craft 公开仓库</a>
        · 分类交叉核对
        <a href={crafting.meta.wikiSource} target="_blank" rel="noreferrer">Don't Starve Wiki</a>
        · 简中数据
        <a href={crafting.meta.chineseItemSource} target="_blank" rel="noreferrer">饥荒维基 ItemTable</a>
      </p>
    </footer>
  </main>
</BaseLayout>
