---
import BaseLayout from "../layouts/BaseLayout.astro";
import CraftingSearch from "../components/CraftingSearch.vue";
import { crafting, craftingCategories } from "../lib/crafting.js";

const base = import.meta.env.BASE_URL;
const characterCategory = craftingCategories.find((category) => category.id === "character");
const stationById = new Map(crafting.stations.map((station) => [station.id, station.name]));
const categoryById = new Map(crafting.categories.map((category) => [category.id, category.name]));
const characterById = new Map(crafting.characters.map((character) => [character.id, character.name]));
const searchItems = crafting.items.map((item) => {
  const categoryNames = item.categoryIds.map((id) => categoryById.get(id)).filter(Boolean);
  return {
    id: item.id,
    name: item.name,
    englishName: item.englishName,
    image: item.image,
    characterId: item.characterId,
    characterName: item.characterId ? characterById.get(item.characterId) : undefined,
    categoryId: item.categoryIds.find((id) => id !== "character"),
    categoryNames,
    stationName: stationById.get(item.stationId),
    searchText: [
      item.id,
      item.name,
      item.englishName,
      item.description,
      stationById.get(item.stationId),
      item.characterId ? characterById.get(item.characterId) : undefined,
      ...categoryNames,
      ...item.materials.flatMap((material) => [material.id, material.name, material.englishName]),
    ]
      .filter(Boolean)
      .join(" ")
      .toLocaleLowerCase("zh-CN"),
  };
});
const description = `《饥荒联机版》${crafting.meta.itemCount} 项制作配方中文速查：先选分类，再查看制作材料与解锁条件。`;
---

<BaseLayout title="饥荒联机版全部制作配方" description={description}>
  <main id="main" class="container crafting-main">
    <section class="crafting-directory" aria-labelledby="crafting-categories-title">
      <CraftingSearch client:load items={searchItems} />
      <div class="crafting-directory-grid">
        {
          craftingCategories.map((category) => (
            <a
              class:list={{
                "crafting-directory-card": true,
                featured: category.id === characterCategory?.id,
              }}
              href={`${base}crafting/${category.id}/`}
            >
              <div class="crafting-directory-image">
                <img src={`${base}${category.image}`} alt={`${category.name}分类`} loading="lazy" />
              </div>
              <div>
                <span>{category.id === "character" ? "下一步选择人物" : "制作分类"}</span>
                <h2>{category.name}</h2>
                <p>{category.count} 项制作</p>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
