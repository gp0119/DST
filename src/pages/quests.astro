---
import QuestExplorer from "../components/QuestExplorer.vue";
import quests from "../data/quests.json";
import BaseLayout from "../layouts/BaseLayout.astro";

const description =
  "《饥荒联机版》任务路线指南：奶奶岛珍珠任务、远古织影者、天体英雄、月亮裂隙 W.A.R.B.O.T. 与暗影圣殿流程和物品清单。";
---

<BaseLayout title="任务路线指南 · 饥荒联机版" description={description}>
  <main id="main" class="container quests-main">
    <QuestExplorer client:load quests={quests.quests} />
  </main>
</BaseLayout>
